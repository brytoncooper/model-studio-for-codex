{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/common/host_settings.schema.json",
  "title": "Shared host settings shapes (engine v1)",
  "definitions": {
    "host_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$",
      "minLength": 1,
      "maxLength": 128
    },
    "document_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "content_hash": {
      "oneOf": [
        {
          "const": "absent"
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "present_content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "context_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "preview_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "field_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "entry_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "maxLength": 2048
    },
    "value_state": {
      "type": "string",
      "enum": [
        "unset",
        "explicit",
        "inherited",
        "managed",
        "unknown"
      ]
    },
    "editability": {
      "type": "string",
      "enum": [
        "editable",
        "managed",
        "projection_owned",
        "unsupported"
      ]
    },
    "application_effect": {
      "type": "string",
      "enum": [
        "immediate",
        "future_session",
        "host_restart",
        "model_deck_restart",
        "unknown"
      ]
    },
    "field_type": {
      "type": "string",
      "enum": [
        "boolean",
        "integer",
        "number",
        "string",
        "enum",
        "string_list",
        "entries"
      ]
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "secret"
      ]
    },
    "constraint_choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": [
            "boolean",
            "integer",
            "number",
            "string"
          ],
          "maxLength": 2048
        },
        "label": {
          "$ref": "#/definitions/label"
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "min_length": {
          "type": "integer",
          "minimum": 0
        },
        "max_length": {
          "type": "integer",
          "minimum": 0
        },
        "max_items": {
          "type": "integer",
          "minimum": 0
        },
        "choices": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/definitions/constraint_choice"
          }
        }
      }
    },
    "field_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "label",
        "type",
        "value_state",
        "editability",
        "application_effect",
        "sensitivity"
      ],
      "properties": {
        "field_id": {
          "$ref": "#/definitions/field_id"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "$ref": "#/definitions/description"
        },
        "type": {
          "$ref": "#/definitions/field_type"
        },
        "value_state": {
          "$ref": "#/definitions/value_state"
        },
        "editability": {
          "$ref": "#/definitions/editability"
        },
        "application_effect": {
          "$ref": "#/definitions/application_effect"
        },
        "sensitivity": {
          "$ref": "#/definitions/sensitivity"
        },
        "configured": {
          "type": "boolean"
        },
        "value": true,
        "default": true,
        "effective": true,
        "constraints": {
          "$ref": "#/definitions/constraints"
        },
        "entries": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/definitions/entry_group"
          }
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "allOf": [
                {
                  "properties": {
                    "sensitivity": {
                      "const": "secret"
                    }
                  }
                },
                {
                  "required": [
                    "configured"
                  ],
                  "not": {
                    "not": {
                      "allOf": [
                        {
                          "not": {
                            "required": [
                              "value"
                            ]
                          }
                        },
                        {
                          "not": {
                            "required": [
                              "default"
                            ]
                          }
                        },
                        {
                          "not": {
                            "required": [
                              "effective"
                            ]
                          }
                        },
                        {
                          "not": {
                            "required": [
                              "entries"
                            ]
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "not": {
                    "properties": {
                      "sensitivity": {
                        "const": "secret"
                      }
                    }
                  }
                },
                {
                  "not": {
                    "required": [
                      "configured"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "oneOf": [
            {
              "allOf": [
                {
                  "properties": {
                    "type": {
                      "const": "entries"
                    }
                  }
                },
                {
                  "oneOf": [
                    {
                      "properties": {
                        "sensitivity": {
                          "const": "public"
                        }
                      },
                      "required": [
                        "entries"
                      ]
                    },
                    {
                      "properties": {
                        "sensitivity": {
                          "const": "secret"
                        }
                      },
                      "not": {
                        "required": [
                          "entries"
                        ]
                      }
                    }
                  ],
                  "not": {
                    "not": {
                      "allOf": [
                        {
                          "not": {
                            "required": [
                              "value"
                            ]
                          }
                        },
                        {
                          "not": {
                            "required": [
                              "default"
                            ]
                          }
                        },
                        {
                          "not": {
                            "required": [
                              "effective"
                            ]
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "not": {
                    "properties": {
                      "type": {
                        "const": "entries"
                      }
                    }
                  }
                },
                {
                  "not": {
                    "required": [
                      "entries"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "oneOf": [
            {
              "allOf": [
                {
                  "properties": {
                    "type": {
                      "const": "boolean"
                    }
                  }
                },
                {
                  "properties": {
                    "value": {
                      "type": "boolean"
                    },
                    "default": {
                      "type": "boolean"
                    },
                    "effective": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "not": {
                    "properties": {
                      "type": {
                        "const": "boolean"
                      }
                    }
                  }
                },
                {}
              ]
            }
          ]
        },
        {
          "oneOf": [
            {
              "allOf": [
                {
                  "properties": {
                    "type": {
                      "const": "integer"
                    }
                  }
                },
                {
                  "properties": {
                    "value": {
                      "type": "integer"
                    },
                    "default": {
                      "type": "integer"
                    },
                    "effective": {
                      "type": "integer"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "not": {
                    "properties": {
                      "type": {
                        "const": "integer"
                      }
                    }
                  }
                },
                {}
              ]
            }
          ]
        },
        {
          "oneOf": [
            {
              "allOf": [
                {
                  "properties": {
                    "type": {
                      "const": "number"
                    }
                  }
                },
                {
                  "properties": {
                    "value": {
                      "type": "number"
                    },
                    "default": {
                      "type": "number"
                    },
                    "effective": {
                      "type": "number"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "not": {
                    "properties": {
                      "type": {
                        "const": "number"
                      }
                    }
                  }
                },
                {}
              ]
            }
          ]
        },
        {
          "oneOf": [
            {
              "allOf": [
                {
                  "properties": {
                    "type": {
                      "const": "string"
                    }
                  }
                },
                {
                  "properties": {
                    "value": {
                      "type": "string",
                      "maxLength": 2048
                    },
                    "default": {
                      "type": "string",
                      "maxLength": 2048
                    },
                    "effective": {
                      "type": "string",
                      "maxLength": 2048
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "not": {
                    "properties": {
                      "type": {
                        "const": "string"
                      }
                    }
                  }
                },
                {}
              ]
            }
          ]
        },
        {
          "oneOf": [
            {
              "allOf": [
                {
                  "properties": {
                    "type": {
                      "const": "enum"
                    }
                  }
                },
                {
                  "properties": {
                    "value": {
                      "type": [
                        "boolean",
                        "number",
                        "string"
                      ],
                      "maxLength": 2048
                    },
                    "default": {
                      "type": [
                        "boolean",
                        "number",
                        "string"
                      ],
                      "maxLength": 2048
                    },
                    "effective": {
                      "type": [
                        "boolean",
                        "number",
                        "string"
                      ],
                      "maxLength": 2048
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "not": {
                    "properties": {
                      "type": {
                        "const": "enum"
                      }
                    }
                  }
                },
                {}
              ]
            }
          ]
        },
        {
          "oneOf": [
            {
              "allOf": [
                {
                  "properties": {
                    "type": {
                      "const": "string_list"
                    }
                  }
                },
                {
                  "properties": {
                    "value": {
                      "type": "array",
                      "maxItems": 256,
                      "items": {
                        "type": "string",
                        "maxLength": 2048
                      }
                    },
                    "default": {
                      "type": "array",
                      "maxItems": 256,
                      "items": {
                        "type": "string",
                        "maxLength": 2048
                      }
                    },
                    "effective": {
                      "type": "array",
                      "maxItems": 256,
                      "items": {
                        "type": "string",
                        "maxLength": 2048
                      }
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "not": {
                    "properties": {
                      "type": {
                        "const": "string_list"
                      }
                    }
                  }
                },
                {}
              ]
            }
          ]
        }
      ]
    },
    "entry_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "label",
        "fields"
      ],
      "properties": {
        "entry_id": {
          "$ref": "#/definitions/entry_id"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "fields": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/definitions/field_descriptor"
          }
        }
      }
    },
    "structured_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "operation"
      ],
      "properties": {
        "field_id": {
          "$ref": "#/definitions/field_id"
        },
        "entry_id": {
          "$ref": "#/definitions/entry_id"
        },
        "operation": {
          "type": "string",
          "enum": [
            "set",
            "unset"
          ]
        },
        "value": true
      },
      "allOf": [
        {
          "oneOf": [
            {
              "allOf": [
                {
                  "properties": {
                    "operation": {
                      "const": "set"
                    }
                  }
                },
                {
                  "required": [
                    "value"
                  ]
                }
              ]
            },
            {
              "allOf": [
                {
                  "not": {
                    "properties": {
                      "operation": {
                        "const": "set"
                      }
                    }
                  }
                },
                {
                  "not": {
                    "required": [
                      "value"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "draft": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "raw_toml"
          ],
          "properties": {
            "kind": {
              "const": "raw"
            },
            "raw_toml": {
              "type": "string",
              "maxLength": 262144
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "changes"
          ],
          "properties": {
            "kind": {
              "const": "structured"
            },
            "changes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "$ref": "#/definitions/structured_change"
              }
            }
          }
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "message"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "field_id": {
          "$ref": "#/definitions/field_id"
        },
        "entry_id": {
          "$ref": "#/definitions/entry_id"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "raw_toml": {
      "type": "string",
      "maxLength": 262144
    }
  }
}
