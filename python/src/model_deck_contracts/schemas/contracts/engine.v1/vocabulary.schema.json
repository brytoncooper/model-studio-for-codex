{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/engine.v1/vocabulary.schema.json",
  "title": "Application-owned vocabulary",
  "definitions": {
    "connection_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection_id",
        "provider_id",
        "revision"
      ],
      "properties": {
        "connection_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "provider_id": {
          "$ref": "../common/types.schema.json#/definitions/reverse_domain_id"
        },
        "endpoint_config_ref": {
          "$ref": "../common/types.schema.json#/definitions/opaque_ref"
        },
        "credential_ref": {
          "$ref": "../common/types.schema.json#/definitions/opaque_ref"
        },
        "revision": {
          "$ref": "../common/types.schema.json#/definitions/revision"
        }
      }
    },
    "normalized_input_text_part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "enum": [
            "input_text",
            "output_text"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 1048576
        }
      }
    },
    "normalized_input_image_part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "image_url"
      ],
      "properties": {
        "type": {
          "const": "input_image"
        },
        "image_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        },
        "detail": {
          "type": "string",
          "enum": [
            "auto",
            "low",
            "high"
          ]
        }
      }
    },
    "normalized_input_item": {
      "description": "Provider-neutral ordered conversation item produced by a host adapter before provider dispatch.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "role",
            "content"
          ],
          "properties": {
            "type": {
              "const": "message"
            },
            "role": {
              "enum": [
                "system",
                "developer"
              ]
            },
            "content": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/definitions/normalized_input_text_part"
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "input_text"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "role",
            "content"
          ],
          "properties": {
            "type": {
              "const": "message"
            },
            "role": {
              "const": "user"
            },
            "content": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "oneOf": [
                  {
                    "allOf": [
                      {
                        "$ref": "#/definitions/normalized_input_text_part"
                      },
                      {
                        "properties": {
                          "type": {
                            "const": "input_text"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "$ref": "#/definitions/normalized_input_image_part"
                  }
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "role",
            "content"
          ],
          "properties": {
            "type": {
              "const": "message"
            },
            "role": {
              "const": "assistant"
            },
            "content": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/definitions/normalized_input_text_part"
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "output_text"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "call_id",
            "name",
            "arguments"
          ],
          "properties": {
            "type": {
              "const": "function_call"
            },
            "call_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "arguments": {
              "type": "string",
              "minLength": 2,
              "maxLength": 1048576,
              "description": "UTF-8 JSON text whose decoded top-level value is an object; the normalized-input codec also rejects duplicate keys and non-finite numbers."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "call_id",
            "output"
          ],
          "properties": {
            "type": {
              "const": "function_call_output"
            },
            "call_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "output": {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 1048576
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4096,
                  "items": {
                    "oneOf": [
                      {
                        "allOf": [
                          {
                            "$ref": "#/definitions/normalized_input_text_part"
                          },
                          {
                            "properties": {
                              "type": {
                                "const": "input_text"
                              }
                            }
                          }
                        ]
                      },
                      {
                        "$ref": "#/definitions/normalized_input_image_part"
                      }
                    ]
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "registered_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registration_id",
        "provider_model_id",
        "connection_id",
        "display_name",
        "revision"
      ],
      "properties": {
        "registration_id": {
          "type": "string",
          "format": "uuid",
          "description": "Registration identity; not provider_model_id"
        },
        "provider_model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "connection_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "display_name": {
          "type": "string",
          "maxLength": 256
        },
        "capability_snapshot_ref": {
          "$ref": "../common/types.schema.json#/definitions/opaque_ref"
        },
        "revision": {
          "$ref": "../common/types.schema.json#/definitions/revision"
        }
      }
    },
    "model_list_item_registered": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "registration_id",
        "provider_model_id",
        "connection_id",
        "display_name",
        "revision"
      ],
      "properties": {
        "kind": {
          "const": "registered"
        },
        "registration_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "provider_model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "connection_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "display_name": {
          "type": "string",
          "maxLength": 256
        },
        "revision": {
          "$ref": "../common/types.schema.json#/definitions/revision"
        }
      }
    },
    "model_list_item_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "provider_model_id",
        "connection_id",
        "display_name"
      ],
      "properties": {
        "kind": {
          "const": "catalog"
        },
        "provider_model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "connection_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "display_name": {
          "type": "string",
          "maxLength": 256
        },
        "catalog_revision": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "model_list_item": {
      "oneOf": [
        {
          "$ref": "#/definitions/model_list_item_registered"
        },
        {
          "$ref": "#/definitions/model_list_item_catalog"
        }
      ]
    },
    "run_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "session_id",
        "state"
      ],
      "properties": {
        "run_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "session_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "client_request_id": {
          "type": "string",
          "maxLength": 64
        },
        "state": {
          "$ref": "../common/types.schema.json#/definitions/run_state"
        },
        "terminal_result": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "completed",
                "failed",
                "cancelled",
                "interrupted"
              ]
            },
            "error": {
              "$ref": "../common/error.schema.json"
            }
          }
        }
      }
    },
    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "tool_name",
        "arguments"
      ],
      "properties": {
        "call_id": {
          "type": "string",
          "maxLength": 128
        },
        "tool_name": {
          "type": "string",
          "maxLength": 128
        },
        "arguments": {
          "$ref": "../common/types.schema.json#/definitions/json_value"
        }
      }
    },
    "operation_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "input_schema_id",
        "output_schema_id",
        "effect"
      ],
      "properties": {
        "operation_id": {
          "$ref": "../common/types.schema.json#/definitions/reverse_domain_id"
        },
        "input_schema_id": {
          "type": "string",
          "maxLength": 256
        },
        "output_schema_id": {
          "type": "string",
          "maxLength": 256
        },
        "effect": {
          "type": "string",
          "enum": [
            "read",
            "write"
          ]
        },
        "required_grants": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "maxItems": 32
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "registration_id",
        "revision"
      ],
      "properties": {
        "session_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "registration_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "revision": {
          "$ref": "../common/types.schema.json#/definitions/revision"
        },
        "host_context_ref": {
          "$ref": "../common/types.schema.json#/definitions/opaque_ref"
        },
        "continuation_scope": {
          "$ref": "#/definitions/continuation_scope"
        }
      }
    },
    "run_options": {
      "type": "object",
      "additionalProperties": false,
      "description": "Transport preferences for a run. Adapters must reject strict or otherwise enforced controls they cannot support before provider dispatch.",
      "properties": {
        "instructions": {
          "type": "string",
          "maxLength": 65536
        },
        "reasoning_effort": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Advisory effort token interpreted against the selected model's supported values."
        },
        "service_tier": {
          "type": "string",
          "enum": [
            "standard",
            "priority",
            "economy"
          ]
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "parallel_tool_calls": {
          "type": "boolean"
        },
        "output_format": {
          "description": "Requested output representation. Strict structured output must be supported before provider dispatch.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "text"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "json_object"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "name",
                "schema"
              ],
              "properties": {
                "type": {
                  "const": "json_schema"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "description": {
                  "type": "string",
                  "maxLength": 1024
                },
                "schema": {
                  "type": "object",
                  "maxProperties": 1024,
                  "additionalProperties": {
                    "$ref": "../common/types.schema.json#/definitions/json_value"
                  }
                },
                "strict": {
                  "type": "boolean"
                }
              }
            }
          ]
        },
        "tool_choice": {
          "description": "Requested tool-selection behavior over the run's authorized tool definitions.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "auto"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "none"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "required"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "tool_name"
              ],
              "properties": {
                "type": {
                  "const": "named"
                },
                "tool_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          ]
        }
      }
    },
    "run_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "client_request_id",
        "idempotency_key",
        "registration_id"
      ],
      "properties": {
        "run_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid",
          "description": "Present after admission; omitted on client start params"
        },
        "session_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "client_request_id": {
          "type": "string",
          "maxLength": 64
        },
        "idempotency_key": {
          "$ref": "../common/types.schema.json#/definitions/idempotency_key"
        },
        "registration_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "messages": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/normalized_input_item"
              },
              "maxItems": 256
            }
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/authorized_tool"
          },
          "maxItems": 128,
          "description": "Authorized tool descriptors for this run"
        },
        "options": {
          "$ref": "#/definitions/run_options"
        }
      }
    },
    "usage_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "session_id",
        "observed_at",
        "units",
        "unit_kind"
      ],
      "properties": {
        "run_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "session_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "registration_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "connection_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "provider_model_id": {
          "type": "string",
          "maxLength": 256
        },
        "observed_at": {
          "$ref": "../common/types.schema.json#/definitions/iso8601"
        },
        "units": {
          "type": "number",
          "minimum": 0
        },
        "unit_kind": {
          "type": "string",
          "enum": [
            "input_tokens",
            "output_tokens",
            "cached_tokens",
            "tool_calls",
            "requests",
            "other"
          ]
        },
        "settled_amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 8
        },
        "estimate_amount": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "run_event_run_accepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "run_id",
        "session_id",
        "sequence",
        "event_schema_version",
        "observed_at"
      ],
      "properties": {
        "kind": {
          "const": "run.accepted"
        },
        "run_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "session_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "event_schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "observed_at": {
          "$ref": "../common/types.schema.json#/definitions/iso8601"
        }
      }
    },
    "run_event_run_started": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "run_id",
        "session_id",
        "sequence",
        "event_schema_version",
        "observed_at"
      ],
      "properties": {
        "kind": {
          "const": "run.started"
        },
        "run_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "session_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "event_schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "observed_at": {
          "$ref": "../common/types.schema.json#/definitions/iso8601"
        }
      }
    },
    "run_event_content_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "run_id",
        "session_id",
        "sequence",
        "event_schema_version",
        "observed_at",
        "delta",
        "channel"
      ],
      "properties": {
        "kind": {
          "const": "content.delta"
        },
        "run_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "session_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "event_schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "observed_at": {
          "$ref": "../common/types.schema.json#/definitions/iso8601"
        },
        "delta": {
          "type": "string",
          "maxLength": 65536
        },
        "channel": {
          "type": "string",
          "enum": [
            "text",
            "reasoning"
          ]
        }
      }
    },
    "run_event_tool_requested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "run_id",
        "session_id",
        "sequence",
        "event_schema_version",
        "observed_at",
        "tool_call"
      ],
      "properties": {
        "kind": {
          "const": "tool.requested"
        },
        "run_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "session_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "event_schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "observed_at": {
          "$ref": "../common/types.schema.json#/definitions/iso8601"
        },
        "tool_call": {
          "$ref": "#/definitions/tool_call"
        }
      }
    },
    "run_event_usage_observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "run_id",
        "session_id",
        "sequence",
        "event_schema_version",
        "observed_at",
        "usage"
      ],
      "properties": {
        "kind": {
          "const": "usage.observed"
        },
        "run_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "session_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "event_schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "observed_at": {
          "$ref": "../common/types.schema.json#/definitions/iso8601"
        },
        "usage": {
          "$ref": "#/definitions/usage_record"
        }
      }
    },
    "run_event_run_cancelling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "run_id",
        "session_id",
        "sequence",
        "event_schema_version",
        "observed_at"
      ],
      "properties": {
        "kind": {
          "const": "run.cancelling"
        },
        "run_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "session_id": {
          "$ref": "../common/types.schema.json#/definitions/uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "event_schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "observed_at": {
          "$ref": "../common/types.schema.json#/definitions/iso8601"
        }
      }
    },
    "run_event_run_completed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "run_id",
        "session_id",
        "sequence",
