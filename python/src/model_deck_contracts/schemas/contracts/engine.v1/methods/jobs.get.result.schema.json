{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/engine.v1/methods/jobs.get.result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled",
        "interrupted"
      ]
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "output": {
      "$ref": "../../common/types.schema.json#/definitions/json_value"
    },
    "resumable": {
      "type": "boolean",
      "description": "The job's operation declared itself resumable, so an interrupted run may be restarted with engine.v1.jobs.resume from its last checkpoint. Absent when the engine cannot state this."
    },
    "resume_count": {
      "type": "integer",
      "minimum": 0,
      "description": "How many times engine.v1.jobs.resume has moved this job back to running. Absent when the engine cannot state this."
    }
  },
  "required": [
    "job_id",
    "state"
  ]
}
