{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/engine.v1/methods/models.list.params.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "collection": {
      "type": "string",
      "enum": [
        "registered",
        "catalog"
      ],
      "default": "registered",
      "description": "registered=library inventory; catalog=cache-only available models for a connection"
    },
    "connection_id": {
      "type": "string",
      "format": "uuid",
      "description": "Required when collection=catalog; optional filter when registered"
    },
    "query": {
      "type": "string",
      "maxLength": 256
    },
    "cursor": {
      "type": "string",
      "maxLength": 256
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    }
  }
}
