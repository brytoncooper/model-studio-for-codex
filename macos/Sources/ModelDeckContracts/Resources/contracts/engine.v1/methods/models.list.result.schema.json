{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/engine.v1/methods/models.list.result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "collection"
  ],
  "properties": {
    "collection": {
      "type": "string",
      "enum": [
        "registered",
        "catalog"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "../vocabulary.schema.json#/definitions/model_list_item"
      },
      "maxItems": 200
    },
    "next_cursor": {
      "type": "string",
      "maxLength": 256
    },
    "cache_only": {
      "type": "boolean",
      "description": "True when collection=catalog; no network implied"
    }
  }
}
