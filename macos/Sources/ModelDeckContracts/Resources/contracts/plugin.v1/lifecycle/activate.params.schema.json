{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/plugin.v1/lifecycle/activate.params.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "activation_token": {
      "type": "string",
      "maxLength": 512
    },
    "allowed_broker_methods": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128
      },
      "maxItems": 64
    },
    "config_revision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "activation_token",
    "allowed_broker_methods"
  ]
}
