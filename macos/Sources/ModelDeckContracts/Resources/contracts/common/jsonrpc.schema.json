{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/common/jsonrpc.schema.json",
  "title": "JSON-RPC 2.0 envelope",
  "definitions": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "method"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "params": {
          "type": "object"
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "result": {
          "type": "object"
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "integer"
            },
            "message": {
              "type": "string"
            },
            "data": {
              "$ref": "error.schema.json"
            }
          }
        }
      }
    }
  }
}
