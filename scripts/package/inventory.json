{
  "format_version": 1,
  "app_name": "Model Deck.app",
  "resources": [
    "codex_settings.py", "provider_bridge.py", "local_router.py", "chat_wire.py",
    "context_compaction.py", "provider_continuation.py", "provider_connections.py",
    "provider_presets.json", "agent_message_wire.py", "cursor_agent.py",
    "cursor_sdk_runtime.py", "model_benchmarks.py", "spawn_benchmarks.py", "pricing.py",
    "model_deck_mcp.py", "routing_registry.py", "provider_usage.py", "model_catalog.py",
    "codex_runtime.py", "CodexProviderBridge"
  ],
  "icons": ["assets/ModelStudio.icns", "assets/ModelStudio.png"],
  "swift_bundles": {
    "ModelDeckContracts": "ModelDeck_ModelDeckContracts.bundle",
    "ModelDeckPresentation": "ModelDeck_ModelDeckPresentation.bundle"
  },
  "vendor": {
    "required_files": [
      "model_deck/__init__.py", "model_deck/bootstrap.py", "model_deck/cli/main.py",
      "model_deck/integrations/clients/mcp/__init__.py",
      "model_deck/integrations/clients/mcp/registry_snapshot.py",
      "model_deck_contracts/__init__.py", "model_deck_contracts/validator.py",
      "model_deck_contracts/schemas/contracts/engine.v1/vocabulary.schema.json",
      "model_deck_contracts/schemas/contracts/plugin.v1/manifest.schema.json",
      "model_deck_root_guard/__init__.py", "model_deck_root_guard/roots.py",
      "jsonschema/__init__.py", "tomlkit/__init__.py"
    ]
  },
  "info_plist": {
    "CFBundleIdentifier": "com.cooper.model-deck",
    "CFBundleName": "Model Deck",
    "CFBundleDisplayName": "Model Deck",
    "CFBundleExecutable": "ModelDeck",
    "CFBundlePackageType": "APPL",
    "CFBundleShortVersionString": "2.1",
    "CFBundleIconFile": "ModelStudio",
    "LSMinimumSystemVersion": "13.0",
    "NSHighResolutionCapable": true
  }
}
