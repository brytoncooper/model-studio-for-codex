{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/notes.update.input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "note_id",
    "expected_revision",
    "title",
    "body"
  ],
  "properties": {
    "note_id": {
      "type": "string",
      "format": "uuid"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "maxLength": 256
    },
    "body": {
      "type": "string",
      "maxLength": 65536
    },
    "metadata": {}
  }
}
