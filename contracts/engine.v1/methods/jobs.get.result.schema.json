{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/engine.v1/methods/jobs.get.result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled",
        "interrupted"
      ]
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "job_id",
    "state"
  ]
}
