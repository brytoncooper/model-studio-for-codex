{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/engine.v1/methods/attachments.export.params.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "attachment_handle": {
      "type": "string",
      "maxLength": 128
    },
    "destination_handle": {
      "type": "string",
      "maxLength": 128,
      "description": "Platform-issued destination; not a plugin path"
    }
  },
  "required": [
    "attachment_handle",
    "destination_handle"
  ]
}
