{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/plugin.v1/lifecycle/invoke.result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "output": {
      "$ref": "../../common/types.schema.json#/definitions/json_value"
    },
    "job_id": {
      "$ref": "../../common/types.schema.json#/definitions/uuid"
    },
    "panel": {
      "$ref": "../../ui.panel.v1/tree.schema.json"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "conflict"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  },
  "oneOf": [
    {
      "required": [
        "output"
      ],
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "required": [
        "error"
      ],
      "not": {
        "required": [
          "output"
        ]
      }
    }
  ]
}
