{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/plugin.v1/broker/attachments.finish.params.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "attachment_handle": {
      "$ref": "../../common/types.schema.json#/definitions/opaque_ref"
    },
    "checksum_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "attachment_handle",
    "checksum_sha256"
  ]
}
